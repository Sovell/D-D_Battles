{
  "name": "dungeons-and-dragons-battles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node ./node_modules/typescript/bin/tsc && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "simulate": "node ./node_modules/esbuild/bin/esbuild scripts/run-headless-simulations.ts --bundle --platform=node --format=esm --outfile=dist/simulation.mjs && node dist/simulation.mjs",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "node ./node_modules/@tauri-apps/cli/tauri.js build"
  },
  "dependencies": {
    "@pixi/react": "^8.0.5",
    "pixi.js": "^8.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.9"
  }
}
